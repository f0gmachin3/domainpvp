{
  "schemaVersion": 1,
  "id": "domainpvp",
  "version": "${version}",
  "name": "PvP Domain",
  "description": "Multiplayer Minecraft PvP mod featuring temporary domain arenas that materialize block by block, isolated 1v1 combat, custom loadouts, and synchronized rematches.",
  "authors": [
    "DomainPvP Team"
  ],
  "contact": {
    "homepage": "https://github.com/domainpvp/domainpvp",
    "sources": "https://github.com/domainpvp/domainpvp"
  },
  "license": "MIT",
  "icon": "assets/domainpvp/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.domainpvp.DomainPvPMod"
    ],
    "client": [
      "com.domainpvp.client.DomainPvPClientMod"
    ],
    "server": [
      "com.domainpvp.server.DomainPvPServerMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*"
  }
}